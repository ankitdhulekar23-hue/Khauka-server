# ============================================================================
# KHAU KA! Hindi Voice Assistant — Backend Environment Configuration
# ============================================================================
# Copy this file to .env for local development.
# On Render, configure these variables in Dashboard -> Environment.
# NEVER commit your actual .env file or real GEMINI_API_KEY to Git!

# Required: Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Server Port (Render automatically injects PORT, default: 10000)
PORT=10000

# Optional: Primary Gemini Live API model (default: models/gemini-3.8-live)
# If the primary model is unavailable for your project tier, the server automatically
# attempts fallback models in GEMINI_MODEL_FALLBACKS.
GEMINI_MODEL=models/gemini-3.8-live

# Optional: Comma-separated fallback models tried in order if primary model fails setup
GEMINI_MODEL_FALLBACKS=models/gemini-3.8-live,models/gemini-3.1-flash-live-preview,models/gemini-2.5-flash-native-audio-preview-12-2025,models/gemini-2.0-flash-exp

# Optional: Prebuilt voice name for Gemini audio output (e.g., Aoede, Puck, Charon, Kore, Fenrir)
GEMINI_VOICE=Aoede

# Optional: Custom system instruction for the Hindi Voice Assistant
SYSTEM_INSTRUCTION=आप "खाऊ का!" (KHAU KA!) नाम के एक स्मार्ट, विनम्र और मददगार हिंदी वॉइस असिस्टेंट और स्मार्ट वज़न कांटा (weighing scale) सहायक हैं। हमेशा स्पष्ट, संक्षिप्त और स्वाभाविक हिंदी में उत्तर दें। यदि उपयोगकर्ता वज़न या खाने-पीने के बारे में पूछे, तो तुरंत उपयोगी जानकारी दें।

# Optional: Device Authentication Token
# When set, ESP32 clients must send header "x-device-token: <token>" or
# "Authorization: Bearer <token>" (or "?token=<token>") when connecting.
# Leave blank/unset to allow unauthenticated ESP32 connections during testing.
DEVICE_AUTH_TOKEN=

# Optional: Connection & Timeout Limits
MAX_CONNECTIONS=10
SETUP_TIMEOUT_MS=15000
HEARTBEAT_INTERVAL_MS=25000
MAX_PRE_SETUP_QUEUE_BYTES=262144
MAX_OUTBOUND_BUFFER_BYTES=1048576
